.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Project source-material duplicates left in the workspace root.
# The canonical, version-controlled copies are:
#     data/raw/EduPro Online Platform.xlsx
#     references/official/project offical detail.pdf
# These root-level originals are the user's own untouched files; they are
# ignored so the repository holds exactly one authoritative copy of each.
# ---------------------------------------------------------------------------
/EduPro Online Platform.xlsx
/project offical detail.pdf
/claude.md.txt

# ---------------------------------------------------------------------------
# Derived data and generated outputs.
# data/raw/ is deliberately NOT ignored - the raw dataset is the authoritative
# input and must be version-controlled for reproducibility (CLAUDE.md s8).
# ---------------------------------------------------------------------------
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large or regenerable binary artifacts are tracked selectively; keep the
# directories present so the pipeline can always write into them.
models/*
!models/.gitkeep
# The frozen production artifact set IS tracked (276 KB in total). Streamlit
# Community Cloud deploys from the repository and cannot run the training
# pipeline, so an untracked artifact set would mean no deployed application.
# This resolves the open item recorded as P-2 in ARCHITECTURE_FREEZE.md.
!models/manifest.json
!models/model_config.json
!models/feature_schema.json
!models/scaler.joblib
!models/clusterer.joblib
reports/figures/*
!reports/figures/.gitkeep

# Rendered pages of the official PDF: regenerable from the tracked source via
# scripts/render_official_pdf.py, so the raster copies are not tracked.
artifacts/official_pdf_pages/

# Local tool configuration (the launch config is Windows-specific; the
# authoritative launch instructions are in docs/deployment.md).
.claude/
